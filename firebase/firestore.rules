rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Pulse owns the shared catalogue. Catalogue data is visible only to
    // authenticated Pulse accounts; changes remain restricted to Pulse admins.
    function isPulseAccount() {
      return request.auth != null
        && exists(/databases/$(database)/documents/User/$(request.auth.uid))
        && get(/databases/$(database)/documents/User/$(request.auth.uid))
            .data.account_type == 'Pulse';
    }

    function isPulseAdmin() {
      return isPulseAccount()
        && (
          get(/databases/$(database)/documents/User/$(request.auth.uid))
              .data.role == 'admin'
          || get(/databases/$(database)/documents/User/$(request.auth.uid))
              .data.role == 'Admin'
          || get(/databases/$(database)/documents/User/$(request.auth.uid))
              .data.role == 'Owner'
          || get(/databases/$(database)/documents/User/$(request.auth.uid))
              .data.role == 'duniya_admin'
        );
    }

    match /ProductMaster/{document} {
      allow read: if isPulseAccount();
      allow create, update, delete: if isPulseAdmin();
    }

    match /User/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if request.auth.uid == document;
      allow delete: if request.auth.uid == document;
    }

    match /User/{parent}/Pharmacy/{document} {
      allow create: if request.auth.uid == parent;
      allow read: if true;
      allow write: if request.auth.uid == parent;
      allow delete: if request.auth.uid == parent;
    }

    match /User/{parent}/Stock/{document} {
      allow create: if request.auth.uid == parent;
      allow read: if true;
      allow write: if request.auth.uid == parent;
      allow delete: if request.auth.uid == parent;
    }

    match /User/{parent}/Sales/{document} {
      allow create: if request.auth.uid == parent;
      allow read: if true;
      allow write: if request.auth.uid == parent;
      allow delete: if request.auth.uid == parent;
    }

    match /User/{parent}/Saleitem/{document} {
      allow create: if request.auth.uid == parent;
      allow read: if true;
      allow write: if request.auth.uid == parent;
      allow delete: if request.auth.uid == parent;
    }

    match /User/{parent}/PharmacyStaff/{document} {
      allow create: if request.auth.uid == parent;
      allow read: if true;
      allow write: if request.auth.uid == parent;
      allow delete: if request.auth.uid == parent;
    }

    match /User/{parent}/Finance/{document} {
      allow create: if request.auth.uid == parent;
      allow read: if true;
      allow write: if request.auth.uid == parent;
      allow delete: if request.auth.uid == parent;
    }

    match /Subscription/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }

    match /Usersubscription/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }

    match /Subscriptionpayment/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }

    match /Staff/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }

    match /User/{parent}/DamagedStock/{document} {
      allow create: if request.auth.uid == parent;
      allow read: if true;
      allow write: if request.auth.uid == parent;
      allow delete: if request.auth.uid == parent;
    }

    // Audit events are append-only. Users may read events from their own
    // owner scope, while the client can only create events as itself.
    match /AuditLogs/{document} {
      allow create: if request.auth != null
        && request.resource.data.actorId == request.auth.uid;
      allow read: if request.auth != null;
      allow update, delete: if false;
    }
  }
}
