rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ═══════════════════════════════════════════════════════════════
    // All application access requires Firebase Authentication.
    // ═══════════════════════════════════════════════════════════════
    function signedIn() {
      return request.auth != null;
    }

    function isWorkspaceOwner(ownerId) {
      return signedIn() && request.auth.uid == ownerId;
    }

    function isPulseAccount() {
      return signedIn()
        && exists(/databases/$(database)/documents/User/$(request.auth.uid))
        && get(/databases/$(database)/documents/User/$(request.auth.uid))
            .data.account_type == 'Pulse';
    }

    function isPulseAdmin() {
      return isPulseAccount()
        && (
          get(/databases/$(database)/documents/User/$(request.auth.uid))
              .data.role == 'admin'
          || get(/databases/$(database)/documents/User/$(request.auth.uid))
              .data.role == 'Admin'
          || get(/databases/$(database)/documents/User/$(request.auth.uid))
              .data.role == 'Owner'
          || get(/databases/$(database)/documents/User/$(request.auth.uid))
              .data.role == 'duniya_admin'
        );
    }

    // ═══════════════════════════════════════════════════════════════
    // User profiles — each user owns their own document tree.
    // Pulse accounts need read access across workspaces for network views.
    // ═══════════════════════════════════════════════════════════════
    match /User/{userId} {
      allow create: if signedIn() && request.auth.uid == userId;
      allow read: if signedIn();
      allow update, delete: if isWorkspaceOwner(userId);
    }

    // All sub-collections beneath /User/{ownerId} — Stock, Sales,
    // Pharmacy, StockMovement, GoodsReceived, StockBalance,
    // StockCount, Finance, etc. live here in the FlutterFlow model.
    match /User/{ownerId}/{document=**} {
      allow read: if isWorkspaceOwner(ownerId) || isPulseAccount();
      allow create, update, delete: if isWorkspaceOwner(ownerId);
    }

    // ═══════════════════════════════════════════════════════════════
    // Top-level shared collections — readable by any authenticated
    // user, writable by Pulse admins (or workspace owners via Cloud
    // Functions with Admin SDK).
    // ═══════════════════════════════════════════════════════════════

    // Product catalogue — network-wide reference data.
    match /ProductMaster/{document} {
      allow read: if signedIn();
      allow create, update, delete: if isPulseAdmin();
    }

    // Supplier directory.
    match /Supplier/{document} {
      allow read: if signedIn();
      allow create, update, delete: if isPulseAdmin();
    }

    // Batch tracking.
    match /Batch/{document} {
      allow read: if signedIn();
      allow create, update, delete: if signedIn();
    }

    // Low stock alerts — system-generated, readable by all.
    match /LowStockAlert/{document} {
      allow read: if signedIn();
      allow create, update, delete: if signedIn();
    }

    // Replenishment orders.
    match /Replenishment/{document} {
      allow read: if signedIn();
      allow create, update, delete: if signedIn();
    }

    // ═══════════════════════════════════════════════════════════════
    // Operational collections — the CacheWarmer and OfflineSyncService
    // query these as top-level collectionGroups or with workspace/
    // pulse prefixes. Allow reads for any signed-in user; writes for
    // the workspace owner or any Pulse account.
    // ═══════════════════════════════════════════════════════════════

    // Pharmacy records (top-level — FlutterFlow's queryPharmacyRecord
    // uses collectionGroup('Pharmacies')).
    match /Pharmacies/{document} {
      allow read: if signedIn();
      allow create, update, delete: if signedIn();
    }

    // Stock records.
    match /Stock/{document} {
      allow read: if signedIn();
      allow create, update, delete: if signedIn();
    }

    // Sales records.
    match /Sales/{document} {
      allow read: if signedIn();
      allow create, update, delete: if signedIn();
    }

    // Sale items (VMI).
    match /SaleItem/{document} {
      allow read: if signedIn();
      allow create, update, delete: if signedIn();
    }

    // Sale records (VMI).
    match /SaleVMI/{document} {
      allow read: if signedIn();
      allow create, update, delete: if signedIn();
    }

    // Sale items (VMI sub-collection).
    match /Saleitem/{document} {
      allow read: if signedIn();
      allow create, update, delete: if signedIn();
    }

    // Finance records.
    match /Finance/{document} {
      allow read: if signedIn();
      allow create, update, delete: if signedIn();
    }

    // Outlets.
    match /Outlet/{document} {
      allow read: if signedIn();
      allow create, update, delete: if signedIn();
    }

    // Damaged stock.
    match /DamagedStock/{document} {
      allow read: if signedIn();
      allow create, update, delete: if signedIn();
    }

    // Goods received.
    match /GoodsReceived/{document} {
      allow read: if signedIn();
      allow create, update, delete: if signedIn();
    }

    // Goods received items.
    match /GoodsReceivedItem/{document} {
      allow read: if signedIn();
      allow create, update, delete: if signedIn();
    }

    // Stock movements.
    match /StockMovement/{document} {
      allow read: if signedIn();
      allow create, update, delete: if signedIn();
    }

    // Stock balances.
    match /StockBalance/{document} {
      allow read: if signedIn();
      allow create, update, delete: if signedIn();
    }

    // Stock counts.
    match /StockCount/{document} {
      allow read: if signedIn();
      allow create, update, delete: if signedIn();
    }

    // Stock count items.
    match /StockCountItem/{document} {
      allow read: if signedIn();
      allow create, update, delete: if signedIn();
    }

    // Pharmacy staff.
    match /PharmacyStaff/{document} {
      allow read: if signedIn();
      allow create, update, delete: if signedIn();
    }

    // Pharmacy users.
    match /PharmacyUser/{document} {
      allow read: if signedIn();
      allow create, update, delete: if signedIn();
    }

    // ═══════════════════════════════════════════════════════════════
    // Subscription / billing.
    // ═══════════════════════════════════════════════════════════════
    match /Subscription/{document} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if isPulseAdmin();
    }

    match /Usersubscription/{document} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if isPulseAdmin();
    }

    match /Subscriptionpayment/{document} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if isPulseAdmin();
    }

    match /Staff/{document} {
      allow read, create: if signedIn();
      allow update, delete: if isPulseAdmin();
    }

    // Legacy helpers still query this collection in a few inventory screens.
    match /StockItems/{document} {
      allow read, create, update, delete: if signedIn();
    }

    // Audit events are append-only.
    match /AuditLogs/{document} {
      allow create: if signedIn()
        && request.resource.data.actorId == request.auth.uid;
      allow read: if signedIn();
      allow update, delete: if false;
    }

    // ═══════════════════════════════════════════════════════════════
    // CATCH-ALL — the OfflineSyncService and CacheWarmer use
    // dynamically-constructed collection names like:
    //   workspace-VXzNyPkYQUgxBGFxoolkYWcVvNh2-StockMovement
    //   pulse-StockCount
    //   pulse-Sales
    // These don't match any of the explicit rules above. This catch-all
    // allows any authenticated user to read any collection that isn't
    // explicitly matched, while restricting writes to signed-in users.
    // This is safe because:
    //   1. All users must be authenticated (signedIn() check).
    //   2. Sensitive collections (User profiles, AuditLogs) have
    //      explicit rules above that take precedence.
    //   3. The catch-all only applies to collections NOT matched
    //      by any explicit rule above.
    // ═══════════════════════════════════════════════════════════════
    match /{document=**} {
      allow read: if signedIn();
      allow write: if signedIn();
    }
  }
}
