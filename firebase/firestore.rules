rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // All application access requires Firebase Authentication. Keeping this
    // check central makes it safe to grant the reads needed by the UI while
    // preventing the previous public access to account and billing records.
    function signedIn() {
      return request.auth != null;
    }

    function isWorkspaceOwner(ownerId) {
      return signedIn() && request.auth.uid == ownerId;
    }

    function isPulseAccount() {
      return signedIn()
        && exists(/databases/$(database)/documents/User/$(request.auth.uid))
        && get(/databases/$(database)/documents/User/$(request.auth.uid))
            .data.account_type == 'Pulse';
    }

    function isPulseAdmin() {
      return isPulseAccount()
        && (
          get(/databases/$(database)/documents/User/$(request.auth.uid))
              .data.role == 'admin'
          || get(/databases/$(database)/documents/User/$(request.auth.uid))
              .data.role == 'Admin'
          || get(/databases/$(database)/documents/User/$(request.auth.uid))
              .data.role == 'Owner'
          || get(/databases/$(database)/documents/User/$(request.auth.uid))
              .data.role == 'duniya_admin'
        );
    }

    // A pharmacy owns all of its operational data beneath /User/{ownerId}.
    // Pulse needs read access across these workspaces for its network views,
    // but writes that cross a workspace boundary must go through a callable
    // Cloud Function (for example, dispatching goods to a pharmacy).
    match /User/{userId} {
      allow create: if signedIn() && request.auth.uid == userId;
      allow read: if signedIn();
      allow update, delete: if isWorkspaceOwner(userId);
    }

    match /User/{ownerId}/{document=**} {
      allow read: if isWorkspaceOwner(ownerId) || isPulseAccount();
      allow create, update, delete: if isWorkspaceOwner(ownerId);
    }

    // Shared catalogue and network reference data. Pharmacy users need to
    // read these records to render inventory, sales, and receiving screens.
    match /ProductMaster/{document} {
      allow read: if signedIn();
      allow create, update, delete: if isPulseAdmin();
    }

    match /Supplier/{document} {
      allow read: if signedIn();
      allow create, update, delete: if isPulseAdmin();
    }

    match /Batch/{document} {
      allow read: if signedIn();
      allow create, update, delete: if isPulseAccount();
    }

    match /LowStockAlert/{document} {
      allow read: if signedIn();
      allow create, update, delete: if isPulseAccount();
    }

    match /Replenishment/{document} {
      allow read: if signedIn();
      allow create, update, delete: if isPulseAccount();
    }

    // Subscription and staff screens query these root collections directly.
    // Clients may create a request/payment record; privileged backend code
    // completes or updates it.
    match /Subscription/{document} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if isPulseAdmin();
    }

    match /Usersubscription/{document} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if isPulseAdmin();
    }

    match /Subscriptionpayment/{document} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if isPulseAdmin();
    }

    match /Staff/{document} {
      allow read, create: if signedIn();
      allow update, delete: if isPulseAdmin();
    }

    // Legacy helpers still query this collection in a few inventory screens.
    match /StockItems/{document} {
      allow read, create, update, delete: if signedIn();
    }

    // Audit events are append-only. Client-side events must identify the
    // signed-in actor; server-side events use the Admin SDK and bypass rules.
    match /AuditLogs/{document} {
      allow create: if signedIn()
        && request.resource.data.actorId == request.auth.uid;
      allow read: if signedIn();
      allow update, delete: if false;
    }

    // Supplier directory — network-wide, readable by any authenticated
    // user. Only Pulse admins can create/update/delete.
    match /Supplier/{document} {
      allow read: if signedIn();
      allow create, update, delete: if isPulseAdmin();
    }
  }
}
